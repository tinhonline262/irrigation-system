                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"soilMoistureOffset\": 0.5,\n    \"airTemperatureOffset\": -1.2,\n    \"airHumidityOffset\": 0.0\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/devices/{{deviceId}}/calibrate",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "admin",
                                "devices",
                                "{{deviceId}}",
                                "calibrate"
                            ]
                        }
                    }
                }
            ]
        }
    ],
