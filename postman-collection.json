{
  "info": {
    "_postman_id": "irrigation-sensor-api",
    "name": "Irrigation System - Sensor API",
    "description": "Test collection for sensor data POST API with random mock data generation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Single Sensor Data Post",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate random sensor data",
              "const deviceIds = ['device-01', 'device-02', 'device-03', 'device-04', 'device-05', 'greenhouse-A', 'greenhouse-B', 'field-1'];",
              "const randomDeviceId = deviceIds[Math.floor(Math.random() * deviceIds.length)];",
              "const temperature = (Math.random() * 35 + 5).toFixed(2); // 5°C to 40°C",
              "const humidity = (Math.random() * 100).toFixed(2); // 0-100%",
              "const soilMoisture = (Math.random() * 100).toFixed(2); // 0-100%",
              "const timestamp = new Date().toISOString();",
              "",
              "// Set as environment variables",
              "pm.environment.set('device_id', randomDeviceId);",
              "pm.environment.set('temperature', temperature);",
              "pm.environment.set('humidity', humidity);",
              "pm.environment.set('soil_moisture', soilMoisture);",
              "pm.environment.set('timestamp', timestamp);",
              "",
              "console.log(`Generated: Device=${randomDeviceId}, Temp=${temperature}°C, Humidity=${humidity}%, Soil=${soilMoisture}%`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Response status is 202 Accepted', function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "",
              "pm.test('Response time is less than 500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{device_id}}\",\n  \"temperature\": {{temperature}},\n  \"humidity\": {{humidity}},\n  \"soilMoisture\": {{soil_moisture}},\n  \"timestamp\": \"{{timestamp}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/sensors/data",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "sensors",
            "data"
          ]
        }
      }
    },
    {
      "name": "Batch Test - 10 Requests",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// This will be run before each iteration in the runner"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{device_id}}\",\n  \"temperature\": {{temperature}},\n  \"humidity\": {{humidity}},\n  \"soilMoisture\": {{soil_moisture}},\n  \"timestamp\": \"{{timestamp}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/sensors/data",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "sensors",
            "data"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "device_id",
      "value": "device-01",
      "type": "string"
    },
    {
      "key": "temperature",
      "value": "25.5",
      "type": "string"
    },
    {
      "key": "humidity",
      "value": "60.0",
      "type": "string"
    },
    {
      "key": "soil_moisture",
      "value": "45.0",
      "type": "string"
    },
    {
      "key": "timestamp",
      "value": "2026-05-07T10:00:00Z",
      "type": "string"
    }
  ]
}
