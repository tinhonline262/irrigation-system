{
    "info": {
        "_postman_id": "irrigation-sensor-api",
        "name": "Irrigation System - Sensor API",
        "description": "Test collection for sensor data POST API with random mock data generation",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Single Sensor Data Post",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "// Generate random sensor data",
                            "const deviceIds = ['device-01', 'device-02', 'device-03', 'device-04', 'device-05', 'greenhouse-A', 'greenhouse-B', 'field-1'];",
                            "const randomDeviceId = deviceIds[Math.floor(Math.random() * deviceIds.length)];",
                            "const temperature = (Math.random() * 35 + 5).toFixed(2); // 5\u00b0C to 40\u00b0C",
                            "const humidity = (Math.random() * 100).toFixed(2); // 0-100%",
                            "const soilMoisture = (Math.random() * 100).toFixed(2); // 0-100%",
                            "const timestamp = new Date().toISOString();",
                            "",
                            "// Set as environment variables",
                            "pm.environment.set('device_id', randomDeviceId);",
                            "pm.environment.set('temperature', temperature);",
                            "pm.environment.set('humidity', humidity);",
                            "pm.environment.set('soil_moisture', soilMoisture);",
                            "pm.environment.set('timestamp', timestamp);",
                            "",
                            "console.log(`Generated: Device=${randomDeviceId}, Temp=${temperature}\u00b0C, Humidity=${humidity}%, Soil=${soilMoisture}%`);"
                        ],
                        "type": "text/javascript"
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Response status is 202 Accepted', function () {",
                            "    pm.response.to.have.status(202);",
                            "});",
                            "",
                            "pm.test('Response time is less than 500ms', function () {",
                            "    pm.expect(pm.response.responseTime).to.be.below(500);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"deviceId\": \"{{device_id}}\",\n  \"temperature\": {{temperature}},\n  \"humidity\": {{humidity}},\n  \"soilMoisture\": {{soil_moisture}},\n  \"timestamp\": \"{{timestamp}}\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/sensors/data",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "sensors",
                        "data"
                    ]
                }
            }
        },
        {
            "name": "Batch Test - 10 Requests",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "// This will be run before each iteration in the runner"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"deviceId\": \"{{device_id}}\",\n  \"temperature\": {{temperature}},\n  \"humidity\": {{humidity}},\n  \"soilMoisture\": {{soil_moisture}},\n  \"timestamp\": \"{{timestamp}}\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/sensors/data",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "sensors",
                        "data"
                    ]
                }
            }
        },
        {
            "name": "Admin Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "if (pm.response.code === 200) {",
                            "    const responseData = pm.response.json();",
                            "    if (responseData.data && responseData.data.token) {",
                            "        pm.environment.set('jwt_token', responseData.data.token);",
                            "        console.log('JWT Token set!');",
                            "    }",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/auth/login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Create Admin Device",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"userId\": \"{{admin_user_id}}\",\n  \"name\": \"Test Admin Device 1\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/admin/devices",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "admin",
                        "devices"
                    ]
                }
            }
        },
        {
            "name": "Admin Options",
            "item": [
                {
                    "name": "Get Users",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/users?page=0&size=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "admin",
                                "users"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "0"
                                },
                                {
                                    "key": "size",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Update User Roles",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"roles\": [\"ADMIN\", \"USER\"]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/users/{{userId}}/roles",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "admin",
                                "users",
                                "{{userId}}",
                                "roles"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Roles",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/roles?page=0&size=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "admin",
                                "roles"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "0"
                                },
                                {
                                    "key": "size",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Role",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"MANAGER\",\n    \"permissions\": [\"DEVICE_READ_ALL\"]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/roles",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "admin",
                                "roles"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Role Permissions",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"permissions\": [\"DEVICE_READ_ALL\", \"USER_READ_ALL\"]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/roles/{{roleId}}/permissions",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "admin",
                                "roles",
                                "{{roleId}}",
                                "permissions"
                            ]
                        }
                    }
                },
                {
                    "name": "Get All Devices",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/devices?page=0&size=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "admin",
                                "devices"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "0"
                                },
                                {
                                    "key": "size",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Device",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/devices/{{deviceId}}",
                            "host": [
